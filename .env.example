# Copy to .env — never commit real values.

# Local runtime data (uploads, renders, file store). Default: ./data
TIRESIAS_DATA_DIR=
# Headless Chrome for Remotion (optional; Remotion downloads one otherwise)
REMOTION_BROWSER_EXECUTABLE=
RENDER_CONCURRENCY=2

# Postgres: Supabase connection string in production; `npm run db:local` locally
DATABASE_URL=

# Phase 2 — BALLDONTLIE (GOAT tier needed for play-by-play). RPM: 5 free/trial, 60 ALL-STAR, 600 GOAT
BALLDONTLIE_API_KEY=
BALLDONTLIE_RPM=5
# Clip discovery (optional)
HIGHLIGHT_API_KEY=
HIGHLIGHTLY_API_KEY=
# Only when using Highlightly via RapidAPI:
HIGHLIGHTLY_BASE_URL=
HIGHLIGHTLY_RAPIDAPI_HOST=

# Phase 4 — Claude
ANTHROPIC_API_KEY=

# Production — Supabase (auth/storage, later)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
