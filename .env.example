# ==========================================================================
# srchr — environment variables
# Copy this file to `.env.local` and fill in the values you have.
#
# DEMO MODE: The app runs fully in demo mode with NO variables set. Demo mode
# is auto-detected when Supabase / Google credentials are missing, so you can
# explore the product (landing, demo report, URL-only audit) out of the box.
# ==========================================================================

# --- Supabase (database + auth + storage) --------------------------------
# From your Supabase project: Settings -> API.
# If these are unset the app falls back to an in-memory store + demo auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY. Never expose to the client. Used for
# privileged writes (audit results, snapshots) that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string (Settings -> Database). Optional; only
# needed if you run migrations via a Postgres client instead of the dashboard.
DATABASE_URL=

# --- Auth.js / session signing -------------------------------------------
# A long random string. Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Google OAuth (shared by Ads / GA4 / Search Console / GTM) -----------
# Create an OAuth 2.0 Client (Web application) in Google Cloud Console.
# Authorized redirect URI: http://localhost:3000/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Google Ads API ------------------------------------------------------
# Apply for a developer token in your Google Ads Manager (MCC) account.
GOOGLE_ADS_DEVELOPER_TOKEN=
# The MCC / manager account id used as login-customer-id (digits only, no dashes).
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Token encryption ----------------------------------------------------
# 32-byte key (base64 or 64-char hex) used to AES-256-GCM encrypt refresh
# tokens at rest. Generate with: openssl rand -base64 32
# In production, source this from a secrets manager (e.g. GCP Secret Manager,
# AWS Secrets Manager, Vault) and rotate periodically — see lib/crypto.ts.
ENCRYPTION_KEY=

# --- PageSpeed Insights (optional) ---------------------------------------
# Enables real Lighthouse performance + mobile scores during crawling.
# Get a key at https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# --- AI summary layer (optional) -----------------------------------------
# Anthropic API key. Powers the polished executive summary. Without it the
# app uses the deterministic summary generator (no quality loss in scoring).
AI_API_KEY=
# Model id for the summary layer.
AI_MODEL=claude-opus-4-8

# --- App ------------------------------------------------------------------
# Public base URL, used to build OAuth redirect URIs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
